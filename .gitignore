# Data directory
data/

# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env

# Generated resource IDs from `kb provision`. Local state, not source: it embeds
# the AWS account id in bucket names and role ARNs, and is rebuilt by re-running
# provision (which is idempotent and reuses whatever already exists).
.kb-state.json

# Terraform. .terraform.lock.hcl is deliberately NOT ignored -- it pins the
# provider versions the module was verified against.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/.terraform.tfstate.lock.info
terraform/*.tfplan
terraform/terraform.tfvars
# Both generated by `terraform apply`; same reasoning as .kb-state.json above.
terraform/kb-state.json
terraform/config.tf.yaml
